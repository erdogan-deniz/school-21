/* Dark theme stylesheet. Loaded by MainWindow._apply_theme() when theme='dark'. */

QMainWindow, QWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
}

QPushButton {
    background-color: #3c3f41;
    color: #f0f0f0;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px;
}

QPushButton:hover {
    background-color: #4c5052;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #3c3f41;
    color: #f0f0f0;
    border: 1px solid #555;
}

QTabWidget::pane {
    border: 1px solid #555;
}
