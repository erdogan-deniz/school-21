{
  // Конфиг markdownlint — один и тот же во всех markdown-проектах Дениза
  // (life, Data Scinece, content, ai-agency). Правишь правила — правь во всех
  // четырёх; различаться может только хвост списка "ignores" (помечен ниже).
  // Структурные правила включены и чинятся автоматически (--fix); косметику глушим.
  //
  // Зачем конфиг вообще: без него линтер стартует с дефолтом MD013=80 и выдаёт
  // сотни ошибок «длина строки» на каждой таблице. Всегда красная проверка
  // не отличает плохое от хорошего так же, как всегда зелёная — реальные дефекты
  // (лишняя пустая строка, сбитый список, битый заголовок) тонут в шуме.
  "config": {
    "default": true,
    "MD013": false, // длина строки — не для заметок и не для таблиц
    "MD024": false, // повторяющиеся заголовки — в заметках норма («Заметки», «Выводы»)
    "MD029": false, // сквозная нумерация списков (Q1..Q19, находки 1..14) — намеренно
    "MD033": false, // inline HTML
    "MD034": false, // «голые» URL
    "MD036": false, // жирный как заголовок-метка — ок для заметок
    "MD040": false, // язык у code fence не всегда нужен
    "MD041": false, // первая строка — заголовок (бывает YAML-фронтматтер)
    "MD059": false, // текст ссылок «here» / «more» — дословный текст заданий School 21
    "MD060": false  // выравнивание пайпов в таблицах — косметика

    // 🪤 Ловушка «правил на консистентность» — MD049 (курсив), MD004 (маркер
    //    списка), MD048 (стиль code fence), MD035 (стиль ---). Они не задают стиль,
    //    а ВЫВОДЯТ эталон по ПЕРВОМУ вхождению в файле. Вставка в начало файла
    //    переопределяет эталон, и сыплются старые строки ниже — ошибки указывают
    //    куда угодно, только не на правку. Правило: смотри, каким стилем написан
    //    файл, и пиши так же. Отдельно: строка внутри цитаты, начинающаяся с `+`
    //    или `-`, парсится как СПИСОК и тоже задаёт эталон маркера.
  },
  "globs": ["**/*.md"],
  "ignores": [
    // Общие: служебные папки инструментов и сам конфиг.
    ".remember/**",
    ".claude/**",
    ".superpowers/**",
    ".playwright-mcp/**",
    "node_modules/**",
    ".markdownlint-cli2.jsonc",

    // Хвост этого проекта (school-21). Не витрина — не линтим:
    "**/charisel/**",        // виртуальные окружения, закоммиченные по ошибке
    "**/site-packages/**",   // вендорные зависимости
    "**/_build/**",          // сборки Sphinx
    "**/superpowers/**",     // планы Claude внутри подпроектов (репо-wide в .gitignore)
    "c/3DViewer_v1.0/src/QtGifImage-master/**" // чужая библиотека, вендор
  ]
}
